# Supabase project (Project settings → API). The publishable key is safe in the browser:
# access is enforced by row level security in supabase/migrations.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: override the CWC API URL (defaults to <VITE_SUPABASE_URL>/functions/v1/api)
VITE_API_URL=
